	</string>

	<string id="ui_mcm_ztc_faction_enabled">
		<text>Enable Faction specific effects</text>
	</string>

	<string id="ui_mcm_ztc_faction_enabled_desc">
		<text>Master switch for all Monolith and SiN faction tweaks below. When off, Monolith psy immunity, rupture resistance, SiN mutant alliance, companions, escorts, and Cicatrix are disabled.</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_title">
		<text>Monolith</text>
	</string>

	<string id="ui_mcm_menu_sin">
