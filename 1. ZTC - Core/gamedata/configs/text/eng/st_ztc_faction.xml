	</string>

	<string id="ui_mcm_ztc_faction_force_shield_recharge_broken_sec">
		<text>Broken charge: seconds per 1%</text>
	</string>

	<string id="ui_mcm_ztc_faction_force_shield_recharge_broken_sec_desc">
		<text>How long Cicatrix takes to gain 1% charge while broken (1-30 sec)</text>
	</string>

