	</string>

	<string id="ui_mcm_ztc_faction_sin_title">
		<text>SiN</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_psy_immunity">
		<text>Monolith psy field immunity</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_easier_companion_recruit">
		<text>Easier Companion Recruitment</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_easier_companion_recruit_desc">
		<text>Monolith players can recruit fellow Monolith field squads through a brotherhood dialog. Requires a non-story ALife squad commander (not debug-spawned loners). Squad headcount cap unchanged.</text>
	</string>

	<string id="st_ztc_monolith_companion_recruit_ask">
		<text>Brother, walk with me. The path is safer together.</text>
	</string>

	<string id="st_ztc_monolith_companion_recruit_agree">
		<text>The Monolith provides. I will follow you, brother.</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_rupture_resistance_desc">
		<text>Damage reduction from melee, cuts, and explosions for Monolith stalkers (0-50%)</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_rupture_resistance_actor">
		<text>Player rupture resistance (%)</text>
	</string>

	<string id="ui_mcm_ztc_faction_monolith_rupture_resistance_npc">
		<text>Monolith NPC rupture resistance (%)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_mutant_alliance_enabled">
		<text>SiN mutant alliance</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_mutant_alliance_enabled_desc">
		<text>SiN stalkers ignore wild mutants unless you attack them. Hostility is remembered for 6 in-game hours.</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_max_companions">
		<text>Max mutant companions (Sin)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_max_companions_desc">
		<text>Maximum number of tamed mutant companions for Sin faction (1-10)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_companion_teleport_dist">
		<text>Companion teleport distance (m)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_companion_teleport_dist_desc">
		<text>How far a tamed mutant can fall behind before it teleports to you (5-50m)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_squad_escorts_enabled">
		<text>Sin squad mutant escorts</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_squad_escort_chance">
		<text>Escort spawn chance (%)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_squad_escort_chance_desc">
		<text>Chance for eligible Sin combat squads to spawn a blind dog escort (0-100%)</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_squad_escorts_max_per_squad">
		<text>Max escorts per squad</text>
	</string>

	<string id="ui_mcm_ztc_faction_sin_squad_escorts_max_active">
		<text>Max active escorts (level)</text>
	</string>

	<string id="ui_mcm_ztc_faction_force_shield_actor_enabled">
		<text>Actor Cicatrix</text>
	</string>

	<string id="ui_mcm_ztc_faction_force_shield_actor_enabled_desc">
		<text>Grants the Cicatrix artifact to SiN players, reduces bullet damage while charged, and recharges over time.</text>
	</string>

	<string id="ui_mcm_ztc_faction_force_shield_npc_enabled">
		<text>NPC Cicatrix</text>
	</string>

	<string id="ui_mcm_ztc_faction_force_shield_npc_enabled_desc">
		<text>Equips SiN NPCs with Cicatrix and reduces bullet damage they take.</text>
	</string>

	<string id="ui_mcm_ztc_faction_force_shield_player_bullet_reduction">
