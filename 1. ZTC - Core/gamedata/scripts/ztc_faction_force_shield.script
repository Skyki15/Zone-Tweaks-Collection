-- Sin Force Shield — passive bullet damage reduction for Sin stalkers and Sin players.

_G.ztc_faction_force_shield = _G.ztc_faction_force_shield or {}

local ARTIFACT_SECTION = "af_ztc_faction_force_shield"
local SAVE_KEY_GRANTED = "ztc_faction_force_shield_actor_granted"
local SAVE_KEY_CHARGE = "ztc_faction_force_shield_actor_charge"
local SAVE_KEY_BROKEN = "ztc_faction_force_shield_actor_broken"
local EQUIP_DELAY_SEC = 0.5
local RETURN_ITEM_DELAY_SEC = 0.15
local HIT_VFX_DEBOUNCE_MS = 150
local HIT_RECOVER_DELAY_SEC = 0.05
local MAX_CHARGE_UPDATE_DELTA_SEC = 2.0
local CHARGE_RECHARGE_NORMAL_SEC_DEFAULT = 5 -- seconds per 1% charge
local CHARGE_RECHARGE_BROKEN_SEC_DEFAULT = 2 -- seconds per 1% charge
local CHARGE_DRAIN_BY_KIND = {
	w_pistol = 0.20,
	w_smg = 0.20,
	w_rifle = 0.40,
	w_sniper = 1.00,
}
local CHARGE_DRAIN_SHOTGUN_PELLET = 0.10
local CHARGE_DRAIN_SHOTGUN_SLUG = 0.70
local ITEM_CONDITION_FLOOR = 0.05 -- engine/utils_item.degrade destroys items at condition 0

local npc_equip_pending = {}
local last_hit_vfx_ts = {}
local actor_shield_granted = false
local actor_shield_charge = 0.0
local actor_shield_broken = false
local grant_create_pending = false
local grant_next_try_ts = 0
local grant_deadline_ts = 0
local condition_sync_next_ts = 0
local last_charge_update_ts = 0
local last_ui_charge_pct = -1
local last_inv_ui_refresh_ts = 0
local last_info_tip_pct = -1
local last_info_tip_id = nil
local INV_UI_REFRESH_MS = 200
local inv_ui_refresh_guard = false
local CONDITION_SYNC_MS = 500
local HIT_VFX_SKIP_TF = 10.0
local hit_recover_pending = false
local ztc_faction_force_shield_schedule_hit_recovery
local artifact_transition_grace_ts = 0
local ARTIFACT_TRANSITION_GRACE_MS = 1500

-- Forward declarations (TimeEvent closures above these implementations must bind locals, not globals)
local ztc_faction_force_shield_actor_has_artifact
local ztc_faction_force_shield_try_grant_actor
local ztc_faction_force_shield_preserve_cicatrix_items

local function ztc_faction_force_shield_get_sim_time_factor()
	if ztc_faction_utils and ztc_faction_utils.get_sim_time_factor then
		return ztc_faction_utils.get_sim_time_factor()
	end
	return 1.0
end

local function ztc_faction_force_shield_obj_is_alive(obj)
	if not obj then
		return false
	end

	local ok, alive = pcall(function()
		return obj.alive and obj:alive()
	end)
	return ok and alive == true
end

local function ztc_faction_force_shield_sim_skip_heavy()
	return ztc_faction_utils
		and ztc_faction_utils.sim_skip_heavy_work
		and ztc_faction_utils.sim_skip_heavy_work()
end

local function ztc_faction_force_shield_sim_interval_ms(base_ms)
	if ztc_faction_utils and ztc_faction_utils.sim_interval_ms then
		return ztc_faction_utils.sim_interval_ms(base_ms)
	end
	return base_ms
end

local PARTICLE_SPARKS = "ztc_faction_greh_shield\\greh_shield_sparks"
local PARTICLE_DISTORT = "ztc_faction_greh_shield\\greh_shield_distort"
local PARTICLE_SHIMMER = "ztc_faction_greh_shield\\greh_shield_shimmer"
local BROKEN_SHIELD_SOUNDS = {
	"cicatrix_sounds\\broken_shield1",
	"cicatrix_sounds\\broken_shield2",
	"cicatrix_sounds\\broken_shield3",
	"cicatrix_sounds\\broken_shield4",
}

local function ztc_faction_force_shield_cfg(key, fallback)
	if ztc_faction_mcm and ztc_faction_mcm.get_config then
		local val = ztc_faction_mcm.get_config(key)
		if val ~= nil then
			return val
		end
	end
	return fallback
end

local function ztc_faction_force_shield_mod_enabled()
	if ztc_faction_utils and ztc_faction_utils.is_mod_enabled and not ztc_faction_utils.is_mod_enabled() then
		return false
	end
	return true
end

local function ztc_faction_force_shield_actor_enabled()
	if not ztc_faction_force_shield_mod_enabled() then
		return false
	end
	return ztc_faction_force_shield_cfg("force_shield_actor_enabled", false) == true
end

local function ztc_faction_force_shield_npc_enabled()
	if not ztc_faction_force_shield_mod_enabled() then
		return false
	end
	return ztc_faction_force_shield_cfg("force_shield_npc_enabled", false) == true
end

local function ztc_faction_force_shield_actor_hooks_wanted()
	if not ztc_faction_force_shield_actor_enabled() then
		return false
	end
	if ztc_faction_utils and ztc_faction_utils.actor_is_sin and ztc_faction_utils.actor_is_sin() then
		return true
	end
	return false
end

local function ztc_faction_force_shield_get_recharge_rate_per_sec(mcm_key, default_sec)
	local sec = tonumber(ztc_faction_force_shield_cfg(mcm_key, default_sec)) or default_sec
	if sec < 1 then
		sec = 1
	elseif sec > 120 then
		sec = 120
	end
	return 0.01 / sec
end

local function ztc_faction_force_shield_get_normal_recharge_rate_per_sec()
	return ztc_faction_force_shield_get_recharge_rate_per_sec("force_shield_recharge_normal_sec", CHARGE_RECHARGE_NORMAL_SEC_DEFAULT)
end

local function ztc_faction_force_shield_get_broken_recharge_rate_per_sec()
	return ztc_faction_force_shield_get_recharge_rate_per_sec("force_shield_recharge_broken_sec", CHARGE_RECHARGE_BROKEN_SEC_DEFAULT)
end

local function ztc_faction_force_shield_get_reduction_percent(mcm_key, legacy_fallback)
	local pct = tonumber(ztc_faction_force_shield_cfg(mcm_key, nil))
	if pct == nil then
		pct = tonumber(ztc_faction_force_shield_cfg("force_shield_bullet_reduction", legacy_fallback)) or legacy_fallback
	end
	if pct < 0 then
		pct = 0
	end
	if mcm_key == "force_shield_player_bullet_reduction" then
		if pct < 10 then
			pct = 10
		elseif pct > 50 then
			pct = 50
		end
	elseif pct > 90 then
		pct = 90
	end
	return pct
end

local function ztc_faction_force_shield_damage_mult(mcm_key, legacy_fallback)
	return 1.0 - (ztc_faction_force_shield_get_reduction_percent(mcm_key, legacy_fallback) / 100.0)
end

local function ztc_faction_force_shield_player_damage_mult()
	return ztc_faction_force_shield_damage_mult("force_shield_player_bullet_reduction", 40)
end

local function ztc_faction_force_shield_npc_damage_mult()
	return ztc_faction_force_shield_damage_mult("force_shield_npc_bullet_reduction", 60)
end

local function ztc_faction_force_shield_get_player_reduction_percent()
	return ztc_faction_force_shield_get_reduction_percent("force_shield_player_bullet_reduction", 40)
end

local function ztc_faction_force_shield_is_artifact(item)
	return item and item:section() == ARTIFACT_SECTION
end

local function ztc_faction_force_shield_obj_on_actor_belt(obj)
	if not obj or not db or not db.actor then
		return false
	end

	local on_belt = false
	pcall(function()
		on_belt = db.actor:is_on_belt(obj)
	end)
	return on_belt
end

local function ztc_faction_force_shield_get_charge_percent()
	return math.floor((actor_shield_charge * 100) + 0.5)
end

local function ztc_faction_force_shield_is_broken()
	return actor_shield_broken == true
end

local function ztc_faction_force_shield_get_charge_color(to_code)
	if not utils_xml or not utils_xml.get_color then
		return nil
	end
	if ztc_faction_force_shield_is_broken() then
		return utils_xml.get_color("ui_gray_2", to_code)
	end
	if utils_xml.get_color_con then
		return utils_xml.get_color_con(ztc_faction_force_shield_get_charge_percent(), to_code)
	end
	return utils_xml.get_color("d_blue", to_code)
end

local function ztc_faction_force_shield_clamp_charge(value)
	if not value or value < 0 then
		return 0.0
	elseif value > 1.0 then
		return 1.0
	end
	return value
end

local function ztc_faction_force_shield_obj_has_on_belt(obj)
	if not obj then
		return false
	end

	local found = false
	pcall(function()
		obj:iterate_belt(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				found = true
			end
		end, obj)
	end)
	return found
end

local function ztc_faction_force_shield_obj_has_in_inventory(obj)
	if not obj then
		return false
	end

	local found = false
	pcall(function()
		obj:iterate_inventory(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				found = true
			end
		end, obj)
	end)
	return found
end

local function ztc_faction_force_shield_obj_has_artifact(obj)
	return ztc_faction_force_shield_obj_has_on_belt(obj) or ztc_faction_force_shield_obj_has_in_inventory(obj)
end

local function ztc_faction_force_shield_actor_has_on_belt()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return false
	end
	return ztc_faction_force_shield_obj_has_on_belt(db.actor)
end

local function ztc_faction_force_shield_actor_has_in_inventory()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return false
	end

	local found = false
	pcall(function()
		db.actor:iterate_inventory(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				found = true
			end
		end, db.actor)
	end)
	return found
end

local function ztc_faction_force_shield_actor_has_artifact_equipped()
	return ztc_faction_force_shield_actor_has_on_belt() or ztc_faction_force_shield_actor_has_in_inventory()
end

local function ztc_faction_force_shield_update_charge(delta_sec)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end
	if not ztc_faction_utils.actor_is_sin() then
		return
	end
	if not ztc_faction_force_shield_actor_has_artifact_equipped() then
		return
	end
	if actor_shield_charge >= 1.0 then
		return
	end
	if not delta_sec or delta_sec <= 0 then
		return
	end

	local recharge_rate = ztc_faction_force_shield_is_broken()
		and ztc_faction_force_shield_get_broken_recharge_rate_per_sec()
		or ztc_faction_force_shield_get_normal_recharge_rate_per_sec()
	actor_shield_charge = ztc_faction_force_shield_clamp_charge(actor_shield_charge + (recharge_rate * delta_sec))

	if ztc_faction_force_shield_is_broken() and actor_shield_charge >= 1.0 then
		actor_shield_broken = false
		last_info_tip_pct = -1
		last_ui_charge_pct = -1
	end
end

local function ztc_faction_force_shield_sync_item_condition(obj)
	if not ztc_faction_force_shield_is_artifact(obj) or not obj.set_condition then
		return
	end

	pcall(function()
		local cond = actor_shield_charge
		if ztc_faction_force_shield_is_broken() or cond < ITEM_CONDITION_FLOOR then
			cond = ITEM_CONDITION_FLOOR
		end
		obj:set_condition(cond)
	end)
end

local function ztc_faction_force_shield_sync_cicatrix_items(force)
	if not force and ztc_faction_force_shield_sim_skip_heavy() then
		return
	end

	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end

	pcall(function()
		db.actor:iterate_inventory(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				ztc_faction_force_shield_sync_item_condition(item)
			end
		end, db.actor)
	end)
	pcall(function()
		db.actor:iterate_belt(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				ztc_faction_force_shield_sync_item_condition(item)
			end
		end, db.actor)
	end)
end

local function ztc_faction_force_shield_sync_actor_items()
	if ztc_faction_force_shield_sim_skip_heavy() then
		return
	end

	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end

	pcall(function()
		db.actor:iterate_inventory(function(_, item)
			ztc_faction_force_shield_sync_item_condition(item)
		end, db.actor)
	end)
	pcall(function()
		db.actor:iterate_belt(function(_, item)
			ztc_faction_force_shield_sync_item_condition(item)
		end, db.actor)
	end)
end

local function ztc_faction_force_shield_refresh_cell_overlay(ci, obj)
	if not ci or not obj then
		return
	end

	ztc_faction_force_shield_sync_item_condition(obj)

	local cond = actor_shield_charge
	local pct = ztc_faction_force_shield_get_charge_percent()

	if ci.bar then
		pcall(function()
			if ci.bar:IsShown() then
				local clamped = cond
				if clamped < 0 then
					clamped = 0
				elseif clamped > 1 then
					clamped = 1
				end
				ci.bar:SetProgressPos(clamped)
			end
		end)
	end

	if ci.cond_text then
		pcall(function()
			if ci.cond_text:IsShown() then
				ci.cond_text:SetText(tostring(pct) .. "%")
				local text_color = ztc_faction_force_shield_get_charge_color(true)
				if text_color then
					ci.cond_text:SetTextColor(text_color)
				end
			end
		end)
	end
end

local function ztc_faction_force_shield_refresh_info_tooltip(info, obj)
	if not info or not obj or not ui_item or not ui_item.get_obj_desc then
		return
	end

	ztc_faction_force_shield_sync_item_condition(obj)

	local desc = ui_item.get_obj_desc(obj)
	if desc and info.desc then
		info.desc:SetText(desc)
		info.desc:AdjustHeightToText()
	end

	if not get_stats_value or not stats_table or not info.stats then
		return
	end

	local typ = info.GetType and info:GetType(ARTIFACT_SECTION)
	local gr = typ and stats_table[typ] and stats_table[typ]["condition"]
	if not gr then
		return
	end

	local val_a = get_stats_value(obj, ARTIFACT_SECTION, gr, "condition")
	if not val_a then
		return
	end

	local valbar_a = math.ceil(val_a * gr.magnitude)
	local unit = gr.unit and gr.unit ~= "" and game.translate_string(gr.unit) or ""
	local sign = gr.sign and valbar_a > 0 and "+" or ""

	for i = 1, #info.stats do
		local ele = info.stats[i]
		if ele.base and ele.base:IsShown() and ele.txt then
			ele.txt:SetText(sign .. valbar_a .. " " .. unit)
			ele.txt:Show(true)
			break
		end
	end
end

local function ztc_faction_force_shield_try_refresh_cell(ci)
	if not ci then
		return nil
	end

	local obj = ci.ID and level.object_by_id(ci.ID)
	if not ztc_faction_force_shield_is_artifact(obj) and ci.section == ARTIFACT_SECTION and ci.ID then
		obj = level.object_by_id(ci.ID)
	end

	if ztc_faction_force_shield_is_artifact(obj) then
		ztc_faction_force_shield_refresh_cell_overlay(ci, obj)
		return obj
	end

	if ci.childs then
		for id in pairs(ci.childs) do
			local child = level.object_by_id(id)
			if ztc_faction_force_shield_is_artifact(child) then
				ztc_faction_force_shield_refresh_cell_overlay(ci, child)
				return child
			end
		end
	end

	return nil
end

local function ztc_faction_force_shield_inventory_ui_open()
	if actor_menu and actor_menu.inventory_opened then
		return actor_menu.inventory_opened()
	end
	return false
end

local function ztc_faction_force_shield_refresh_open_inventory_ui()
	if not ztc_faction_force_shield_inventory_ui_open() then
		return
	end
	if not ui_inventory or not ui_inventory.inventory then
		return
	end

	pcall(function()
		ztc_faction_force_shield_refresh_inventory_cells(ui_inventory.inventory)
	end)
end

-- Good-balance perf: refresh Cicatrix bar only on inventory open or hit-driven charge
-- changes — not while recharge ticks with inventory left open.
local function ztc_faction_force_shield_refresh_inventory_on_charge_change()
	last_ui_charge_pct = ztc_faction_force_shield_get_charge_percent()
	ztc_faction_force_shield_refresh_open_inventory_ui()
end

local function ztc_faction_force_shield_schedule_post_inventory_work()
	if not ztc_faction_force_shield_actor_hooks_wanted() then
		return
	end

	CreateTimeEvent("ztc_faction_fs_inv_close", "go", 0.1, function()
		if ztc_faction_force_shield_inventory_ui_open() then
			return false
		end
		if ztc_faction_force_shield_actor_enabled()
			and ztc_faction_utils
			and ztc_faction_utils.actor_is_sin
			and ztc_faction_utils.actor_is_sin() then
			if not ztc_faction_force_shield_actor_has_artifact() then
				ztc_faction_force_shield_try_grant_actor()
			end
			ztc_faction_force_shield_preserve_cicatrix_items()
			ztc_faction_force_shield_try_install_actor_hooks()
		end
		return true
	end)
end

function ztc_faction_force_shield_on_actor_menu_mode(mode, last_mode)
	if mode == 1 and ztc_faction_force_shield_actor_hooks_wanted() then
		CreateTimeEvent("ztc_faction_fs_inv_open", "go", 0.05, function()
			ztc_faction_force_shield_refresh_inventory_on_charge_change()
			return true
		end)
	end
	if mode == 0 and (last_mode == 1 or last_mode == 2 or last_mode == 4) then
		ztc_faction_force_shield_sync_actor_items()
		ztc_faction_force_shield_schedule_post_inventory_work()
	end
end

local function ztc_faction_force_shield_refresh_inventory_cells(inventory)
	if inv_ui_refresh_guard then
		return
	end

	if not inventory or not inventory.CC then
		return
	end

	inv_ui_refresh_guard = true

	local now = time_global()
	if (now - last_inv_ui_refresh_ts) < INV_UI_REFRESH_MS then
		inv_ui_refresh_guard = false
		return
	end
	last_inv_ui_refresh_ts = now

	ztc_faction_force_shield_sync_cicatrix_items()

	local bags = {"actor_belt", "actor_bag", "actor_quick", "actor_equ"}
	local refreshed_obj = nil

	for _, bag in ipairs(bags) do
		local cc = inventory.CC[bag]
		if cc and cc.cell then
			for _, ci in pairs(cc.cell) do
				local obj = ztc_faction_force_shield_try_refresh_cell(ci)
				if obj then
					refreshed_obj = obj
				end
			end
		end
	end

	inv_ui_refresh_guard = false
end

local function ztc_faction_force_shield_install_cell_hook()
	if ztc_faction_force_shield._cell_hooked or not utils_ui or not utils_ui.UICellItem then
		return
	end

	ztc_faction_force_shield._cell_hooked = true
	ztc_faction_force_shield._cell_update_orig = utils_ui.UICellItem.Update

	function utils_ui.UICellItem:Update(obj)
		obj = obj or (self.ID and level.object_by_id(self.ID))
		if ztc_faction_force_shield_is_artifact(obj) then
			ztc_faction_force_shield_sync_item_condition(obj)
		elseif self.section == ARTIFACT_SECTION and self.ID then
			local item = level.object_by_id(self.ID)
			if ztc_faction_force_shield_is_artifact(item) then
				ztc_faction_force_shield_sync_item_condition(item)
				obj = item
			end
		end
		return ztc_faction_force_shield._cell_update_orig(self, obj)
	end

	if Add_Condition_Text then
		ztc_faction_force_shield._cond_text_orig = Add_Condition_Text

		function Add_Condition_Text(self, xml, obj, sec, clsid)
			if sec == ARTIFACT_SECTION and obj then
				ztc_faction_force_shield_sync_item_condition(obj)
			end
			return ztc_faction_force_shield._cond_text_orig(self, xml, obj, sec, clsid)
		end
	end
end

local function ztc_faction_force_shield_install_info_hook()
	if ztc_faction_force_shield._info_hooked or not utils_ui or not utils_ui.UIInfoItem then
		return
	end

	ztc_faction_force_shield._info_hooked = true
	ztc_faction_force_shield._info_update_orig = utils_ui.UIInfoItem.Update

	function utils_ui.UIInfoItem:Update(obj, sec, flags)
		if obj and ztc_faction_force_shield_is_artifact(obj) then
			ztc_faction_force_shield_sync_item_condition(obj)
		elseif sec == ARTIFACT_SECTION and self.id then
			local item = level.object_by_id(self.id)
			if ztc_faction_force_shield_is_artifact(item) then
				ztc_faction_force_shield_sync_item_condition(item)
				obj = item
			end
		end

		return ztc_faction_force_shield._info_update_orig(self, obj, sec, flags)
	end
end

local function ztc_faction_force_shield_install_inventory_hook()
	-- No UIInventory.Update / UpdateInfo hooks — they ran every frame and could freeze
	-- inventory. Cicatrix bar refresh is open/hit-only (see refresh_inventory_on_charge_change).
end

local function ztc_faction_force_shield_mark_artifact_transition()
	artifact_transition_grace_ts = time_global() + ARTIFACT_TRANSITION_GRACE_MS
end

local function ztc_faction_force_shield_artifact_transition_active()
	return time_global() < artifact_transition_grace_ts
end

local function ztc_faction_force_shield_actor_has_artifact_safe()
	if ztc_faction_utils and ztc_faction_utils.actor_is_valid and ztc_faction_utils.actor_is_valid() then
		local found = false
		pcall(function()
			db.actor:iterate_inventory(function(_, item)
				if ztc_faction_force_shield_is_artifact(item) then
					found = true
				end
			end, db.actor)
		end)
		if found or ztc_faction_force_shield_actor_has_on_belt() then
			return true
		end
	end

	if actor_shield_granted and ztc_faction_force_shield_artifact_transition_active() then
		return true
	end
	return false
end

local function ztc_faction_force_shield_release_vanilla_arty_hit_guard()
	if not ztc_faction_force_shield._vanilla_arty_hit_guard_installed then
		return
	end

	local orig = ztc_faction_force_shield._vanilla_arty_hit_orig
	local wrapped = ztc_faction_force_shield._vanilla_arty_hit_wrapped

	if orig then
		_G.actor_on_before_hit = orig
		pcall(function()
			if wrapped then
				UnregisterScriptCallback("actor_on_before_hit", wrapped)
			end
			RegisterScriptCallback("actor_on_before_hit", orig)
		end)
	end

	ztc_faction_force_shield._vanilla_arty_hit_guard_installed = false
	ztc_faction_force_shield._vanilla_arty_hit_wrapped = nil
	ztc_faction_force_shield._vanilla_arty_hit_orig = nil
end

local function ztc_faction_force_shield_release_actor_hooks()
	if ztc_faction_force_shield._degrade_orig and utils_item then
		utils_item.degrade = ztc_faction_force_shield._degrade_orig
		ztc_faction_force_shield._degrade_orig = nil
	end

	ztc_faction_force_shield_release_vanilla_arty_hit_guard()
	ztc_faction_force_shield._protect_hooked = false
end

local function ztc_faction_force_shield_install_vanilla_arty_hit_guard()
	if ztc_faction_force_shield._vanilla_arty_hit_guard_installed then
		return
	end

	local orig = _G.actor_on_before_hit
	if not orig or orig == ztc_faction_force_shield._vanilla_arty_hit_wrapped then
		return
	end

	ztc_faction_force_shield._vanilla_arty_hit_orig = orig

	local function wrapped_actor_on_before_hit(s_hit)
		if not s_hit or s_hit.power <= 0 then
			return
		end

		local cicatrix_present = false
		local other_belt_artefacts = false

		if db and db.actor then
			pcall(function()
				db.actor:iterate_belt(function(_, item)
					if ztc_faction_force_shield_is_artifact(item) then
						cicatrix_present = true
						ztc_faction_force_shield_sync_item_condition(item)
					elseif IsArtefact and IsArtefact(item) then
						other_belt_artefacts = true
					end
				end, db.actor)
			end)
			pcall(function()
				db.actor:iterate_inventory(function(_, item)
					if ztc_faction_force_shield_is_artifact(item) then
						cicatrix_present = true
						ztc_faction_force_shield_sync_item_condition(item)
					end
				end, db.actor)
			end)
		end

		if other_belt_artefacts then
			ztc_faction_force_shield._vanilla_arty_hit_orig(s_hit)
		end

		if cicatrix_present then
			ztc_faction_force_shield_preserve_cicatrix_items()
		end
	end

	ztc_faction_force_shield._vanilla_arty_hit_wrapped = wrapped_actor_on_before_hit
	_G.actor_on_before_hit = wrapped_actor_on_before_hit

	pcall(function()
		UnregisterScriptCallback("actor_on_before_hit", orig)
		RegisterScriptCallback("actor_on_before_hit", wrapped_actor_on_before_hit)
	end)

	ztc_faction_force_shield._vanilla_arty_hit_guard_installed = true
end

local function ztc_faction_force_shield_install_item_protection_hooks()
	if ztc_faction_force_shield._protect_hooked then
		return
	end

	if utils_item and utils_item.degrade and not ztc_faction_force_shield._degrade_orig then
		ztc_faction_force_shield._degrade_orig = utils_item.degrade

		function utils_item.degrade(obj, num)
			if ztc_faction_force_shield_is_artifact(obj) then
				ztc_faction_force_shield_sync_item_condition(obj)
				return obj:condition()
			end
			return ztc_faction_force_shield._degrade_orig(obj, num)
		end
	end

	ztc_faction_force_shield_install_vanilla_arty_hit_guard()

	ztc_faction_force_shield._protect_hooked = true
end

local function ztc_faction_force_shield_install_ui_hooks()
	ztc_faction_force_shield_install_cell_hook()
	ztc_faction_force_shield_install_info_hook()
	ztc_faction_force_shield_install_inventory_hook()
end

local function ztc_faction_force_shield_install_ui_hook()
	if not ui_item or not ui_item.build_desc_header or ztc_faction_force_shield._ui_hooked then
		return
	end

	ztc_faction_force_shield._ui_hooked = true
	ztc_faction_force_shield._build_desc_header_orig = ui_item.build_desc_header

	function ui_item.build_desc_header(obj, sec, str)
		local res = ztc_faction_force_shield._build_desc_header_orig(obj, sec, str)
		if sec == ARTIFACT_SECTION and obj then
			local charge_pct = ztc_faction_force_shield_get_charge_percent()
			local on_belt = ztc_faction_force_shield_obj_on_actor_belt(obj)
			local broken = ztc_faction_force_shield_is_broken()
			local charge_clr = ztc_faction_force_shield_get_charge_color() or ""
			local status_key = "st_af_ztc_faction_force_shield_status_standby"
			if broken then
				status_key = "st_af_ztc_faction_force_shield_status_broken"
			elseif on_belt then
				status_key = charge_pct >= 100 and "st_af_ztc_faction_force_shield_status_active" or "st_af_ztc_faction_force_shield_status_charging"
			elseif charge_pct < 100 then
				status_key = "st_af_ztc_faction_force_shield_status_charging"
			end
			local status = game and game.translate_string(status_key) or (broken and "broken" or (on_belt and (charge_pct >= 100 and "active" or "charging") or "standby"))
			local label = game and game.translate_string("st_af_ztc_faction_force_shield_charge") or "Shield charge"
			res = " \\n " .. label .. ": " .. charge_clr .. tostring(charge_pct) .. "% (" .. status .. ")\\n \\n" .. (res or "")
		end
		return res
	end
end

function ztc_faction_force_shield_try_install_ui_hooks()
	if not ztc_faction_force_shield_actor_hooks_wanted() then
		return
	end
	ztc_faction_force_shield_install_ui_hook()
	ztc_faction_force_shield_install_ui_hooks()
end

function ztc_faction_force_shield_try_install_actor_hooks()
	if not ztc_faction_force_shield_actor_hooks_wanted() then
		ztc_faction_force_shield_release_actor_hooks()
		return
	end
	ztc_faction_force_shield_try_install_ui_hooks()
	ztc_faction_force_shield_install_item_protection_hooks()
end

ztc_faction_force_shield.try_install_ui_hooks = ztc_faction_force_shield_try_install_ui_hooks
ztc_faction_force_shield.try_install_actor_hooks = ztc_faction_force_shield_try_install_actor_hooks
ztc_faction_force_shield.actor_hooks_wanted = ztc_faction_force_shield_actor_hooks_wanted

local function ztc_faction_force_shield_is_bullet_hit(shit)
	if not shit or not shit.type or not hit or hit.fire_wound == nil then
		return false
	end
	return shit.type == hit.fire_wound
end

local function ztc_faction_force_shield_apply_reduction(shit, damage_mult)
	if not ztc_faction_force_shield_is_bullet_hit(shit) then
		return
	end
	if not shit.power or shit.power <= 0 then
		return
	end

	shit.power = shit.power * damage_mult
end

local function ztc_faction_force_shield_debug_log(fmt, ...)
	if ztc_faction_force_shield_cfg("force_shield_debug_log", false) ~= true then
		return
	end
	printf("~[ztc_faction_force_shield] " .. string.format(fmt, ...))
end

local function ztc_faction_force_shield_lock_item(item)
	if not item then
		return
	end
	pcall(function()
		item:set_can_take(false)
	end)
end

local function ztc_faction_force_shield_get_item_by_id(obj_id)
	if not obj_id then
		return nil
	end

	local item = level and level.object_by_id(obj_id)
	if not item then
		return nil
	end

	local ok, section = pcall(function()
		return item:section()
	end)
	if not ok or not section then
		return nil
	end

	return item
end

local function ztc_faction_force_shield_return_item_to_actor(obj_id)
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end

	local item = ztc_faction_force_shield_get_item_by_id(obj_id)
	if not item or not ztc_faction_force_shield_is_artifact(item) then
		return
	end

	pcall(function()
		local parent = item:parent()
		if parent and parent:id() ~= db.actor:id() then
			db.actor:transfer_item(item, db.actor)
		else
			db.actor:move_to_ruck(item)
		end
	end)

	ztc_faction_force_shield_lock_item(item)
end

local function ztc_faction_force_shield_schedule_return_to_actor(obj, event_prefix)
	if not obj then
		return
	end

	local obj_id = obj:id()
	local event_name = event_prefix .. "_" .. tostring(obj_id)
	CreateTimeEvent(event_name, "go", RETURN_ITEM_DELAY_SEC, function()
		ztc_faction_force_shield_return_item_to_actor(obj_id)
		return true
	end)
end

local function ztc_faction_force_shield_get_vfx_pos(obj, bone_id)
	if not obj then
		return nil
	end

	local pos = nil
	pcall(function()
		if bone_id and bone_id >= 0 then
			local bone_name = obj:bone_name(bone_id)
			if bone_name then
				pos = obj:bone_position(bone_name)
			end
		end
		if not pos then
			pos = obj:position()
			pos.y = pos.y + 1.0
		end
	end)
	return pos
end

local function ztc_faction_force_shield_spawn_particle(path, pos)
	if not pos then
		return
	end

	pcall(function()
		local particle = particles_object(path)
		if particle then
			particle:play_at_pos(pos)
		end
	end)
end

local function ztc_faction_force_shield_play_hit_vfx(obj, bone_id)
	if not obj then
		return
	end

	if ztc_faction_force_shield_get_sim_time_factor() >= HIT_VFX_SKIP_TF then
		return
	end

	local id = obj:id()
	local now = time_global()
	if last_hit_vfx_ts[id] and (now - last_hit_vfx_ts[id]) < HIT_VFX_DEBOUNCE_MS then
		return
	end
	last_hit_vfx_ts[id] = now

	local pos = ztc_faction_force_shield_get_vfx_pos(obj, bone_id)
	ztc_faction_force_shield_spawn_particle(PARTICLE_SPARKS, pos)
	ztc_faction_force_shield_spawn_particle(PARTICLE_DISTORT, pos)
	ztc_faction_force_shield_spawn_particle(PARTICLE_SHIMMER, pos)
end

local function ztc_faction_force_shield_play_broken_sound()
	if not db or not db.actor then
		return
	end

	local path = BROKEN_SHIELD_SOUNDS[math.random(1, #BROKEN_SHIELD_SOUNDS)]
	pcall(function()
		local snd = sound_object(path)
		if snd then
			snd:play_no_feedback(db.actor, sound_object.s3d, 0, db.actor:position(), 1.0, 1.0)
		end
	end)
end

local function ztc_faction_force_shield_set_broken()
	if actor_shield_broken then
		return false
	end

	actor_shield_broken = true
	actor_shield_charge = 0.0
	last_info_tip_pct = -1
	last_ui_charge_pct = -1
	ztc_faction_force_shield_play_broken_sound()
	ztc_faction_force_shield_debug_log("shield broken")
	ztc_faction_force_shield_mark_artifact_transition()
	ztc_faction_force_shield_sync_cicatrix_items(true)
	return true
end

local function ztc_faction_force_shield_resolve_hit_weapon(shit)
	if not shit or not shit.draftsman then
		return nil
	end

	local wpn = nil
	pcall(function()
		if shit.weapon_id and shit.weapon_id ~= 0 then
			wpn = level.object_by_id(shit.weapon_id)
		end
		if not wpn and shit.draftsman.active_item then
			wpn = shit.draftsman:active_item()
		end
	end)

	if not wpn then
		return nil
	end
	if IsWeapon and not IsWeapon(wpn) then
		return nil
	end
	if IsMelee and IsMelee(wpn) then
		return nil
	end
	if IsGrenade and IsGrenade(wpn) then
		return nil
	end
	return wpn
end

local function ztc_faction_force_shield_get_weapon_ammo_sec(wpn)
	if not wpn or not utils_item or not utils_item.get_ammo then
		return nil
	end

	local ammo_sec = nil
	pcall(function()
		local wpn_sec = wpn:section()
		local ammo_list = utils_item.get_ammo(wpn_sec, wpn:id())
		if not ammo_list or #ammo_list == 0 then
			return
		end
		local ammo_type = wpn:get_ammo_type() or 0
		ammo_sec = ammo_list[ammo_type + 1]
	end)
	return ammo_sec
end

local function ztc_faction_force_shield_is_shotgun_slug_ammo(ammo_sec)
	if not ammo_sec or ammo_sec == "" then
		return false
	end

	local lower = string.lower(ammo_sec)
	if string.find(lower, "slug", 1, true)
		or string.find(lower, "zhekan", 1, true)
		or string.find(lower, "shrapnel", 1, true) then
		return true
	end

	if ini_sys then
		local buck_shot = ini_sys:r_float_ex(ammo_sec, "buck_shot")
		if buck_shot and buck_shot <= 1 then
			return true
		end
	end

	return false
end

local function ztc_faction_force_shield_get_shotgun_charge_drain(wpn)
	local ammo_sec = ztc_faction_force_shield_get_weapon_ammo_sec(wpn)
	if ztc_faction_force_shield_is_shotgun_slug_ammo(ammo_sec) then
		return CHARGE_DRAIN_SHOTGUN_SLUG
	end
	return CHARGE_DRAIN_SHOTGUN_PELLET
end

local function ztc_faction_force_shield_get_charge_drain(shit)
	local wpn = ztc_faction_force_shield_resolve_hit_weapon(shit)
	if not wpn then
		return CHARGE_DRAIN_BY_KIND.w_rifle
	end

	local kind = nil
	if ini_sys then
		pcall(function()
			kind = ini_sys:r_string_ex(wpn:section(), "kind")
		end)
	end

	if kind == "w_shotgun" or (IsShotgun and IsShotgun(wpn)) then
		return ztc_faction_force_shield_get_shotgun_charge_drain(wpn)
	end

	local drain = kind and CHARGE_DRAIN_BY_KIND[kind]
	if drain then
		return drain
	end

	if IsSniper and IsSniper(wpn) then
		return CHARGE_DRAIN_BY_KIND.w_sniper
	elseif IsPistol and IsPistol(wpn) then
		return CHARGE_DRAIN_BY_KIND.w_pistol
	elseif IsRifle and IsRifle(wpn) then
		return CHARGE_DRAIN_BY_KIND.w_rifle
	end

	return CHARGE_DRAIN_BY_KIND.w_rifle
end

local function ztc_faction_force_shield_drain_charge_from_hit(shit)
	if ztc_faction_force_shield_is_broken() then
		return
	end

	local drain = ztc_faction_force_shield_get_charge_drain(shit)
	if not drain or drain <= 0 then
		return
	end

	actor_shield_charge = ztc_faction_force_shield_clamp_charge(actor_shield_charge - drain)
	ztc_faction_force_shield_debug_log("charge drained %.0f%% (now %d%%)", drain * 100, ztc_faction_force_shield_get_charge_percent())

	if actor_shield_charge <= 0 then
		if ztc_faction_force_shield_set_broken() then
			ztc_faction_force_shield_schedule_hit_recovery(true)
		end
	end
end

local function ztc_faction_force_shield_handle_bullet_hit(target, shit, bone_id, damage_mult, drain_on_hit)
	if not ztc_faction_force_shield_is_bullet_hit(shit) then
		return
	end
	if not shit.power or shit.power <= 0 then
		return
	end

	ztc_faction_force_shield_apply_reduction(shit, damage_mult)
	if drain_on_hit then
		ztc_faction_force_shield_drain_charge_from_hit(shit)
	end
	ztc_faction_force_shield_play_hit_vfx(target, bone_id)
end

ztc_faction_force_shield_actor_has_artifact = function()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return false
	end

	local found = false
	pcall(function()
		db.actor:iterate_inventory(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				found = true
			end
		end, db.actor)
	end)
	if found then
		return true
	end
	return ztc_faction_force_shield_actor_has_on_belt()
end

local function ztc_faction_force_shield_lock_actor_artifacts()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end

	pcall(function()
		db.actor:iterate_inventory(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				ztc_faction_force_shield_lock_item(item)
			end
		end, db.actor)
	end)
	pcall(function()
		db.actor:iterate_belt(function(_, item)
			if ztc_faction_force_shield_is_artifact(item) then
				ztc_faction_force_shield_lock_item(item)
			end
		end, db.actor)
	end)
end

local function ztc_faction_force_shield_count_unique_artifacts()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return 0
	end

	local seen = {}
	local count = 0

	local function count_item(_, item)
		if not ztc_faction_force_shield_is_artifact(item) then
			return
		end
		local id = item:id()
		if id and not seen[id] then
			seen[id] = true
			count = count + 1
		end
	end

	pcall(function()
		db.actor:iterate_belt(count_item, db.actor)
		db.actor:iterate_inventory(count_item, db.actor)
	end)

	return count
end

local function ztc_faction_force_shield_release_item(item, force)
	if not item or not ztc_faction_force_shield_is_artifact(item) then
		return
	end

	if not force and ztc_faction_force_shield_count_unique_artifacts() <= 1 then
		ztc_faction_force_shield_debug_log("blocked release of last Cicatrix id=%s", tostring(item:id()))
		ztc_faction_force_shield_lock_item(item)
		return
	end

	pcall(function()
		local id = item:id()
		if not id then
			return
		end
		local se = alife_object(id)
		if se then
			alife_release(se)
		elseif alife_release_id then
			alife_release_id(id)
		end
	end)
end

local function ztc_faction_force_shield_prune_duplicate_artifacts()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return false
	end

	local keep = nil
	local extras = {}
	local seen_ids = {}

	local function collect(_, item)
		if not ztc_faction_force_shield_is_artifact(item) then
			return
		end

		local id = item:id()
		if not id or seen_ids[id] then
			return
		end
		seen_ids[id] = true

		if not keep then
			keep = item
		else
			extras[#extras + 1] = item
		end
	end

	pcall(function()
		db.actor:iterate_belt(collect, db.actor)
		db.actor:iterate_inventory(collect, db.actor)
	end)

	for _, item in ipairs(extras) do
		ztc_faction_force_shield_release_item(item, true)
		ztc_faction_force_shield_debug_log("removed duplicate Cicatrix id=%s", tostring(item and item:id()))
	end

	if keep then
		ztc_faction_force_shield_lock_item(keep)
	end

	return keep ~= nil
end

local function ztc_faction_force_shield_prune_owner_duplicate_artifacts(owner, keep_count)
	if not owner then
		return false
	end

	keep_count = tonumber(keep_count) or 1
	if keep_count < 0 then
		keep_count = 0
	end

	local keep = {}
	local extras = {}
	local seen_ids = {}

	local function collect(_, item)
		if not ztc_faction_force_shield_is_artifact(item) then
			return
		end

		local id = item:id()
		if not id or seen_ids[id] then
			return
		end
		seen_ids[id] = true

		if #keep < keep_count then
			keep[#keep + 1] = item
		else
			extras[#extras + 1] = item
		end
	end

	pcall(function()
		owner:iterate_belt(collect, owner)
		owner:iterate_inventory(collect, owner)
	end)

	for _, item in ipairs(extras) do
		ztc_faction_force_shield_release_item(item, true)
		ztc_faction_force_shield_debug_log(
			"removed duplicate Cicatrix on %s id=%s",
			owner:name(),
			tostring(item and item:id())
		)
	end

	for _, item in ipairs(keep) do
		ztc_faction_force_shield_lock_item(item)
	end

	return #keep > 0
end

local function ztc_faction_force_shield_count_owner_artifacts(owner)
	if not owner then
		return 0
	end

	local seen = {}
	local count = 0

	local function count_item(_, item)
		if not ztc_faction_force_shield_is_artifact(item) then
			return
		end
		local id = item:id()
		if id and not seen[id] then
			seen[id] = true
			count = count + 1
		end
	end

	pcall(function()
		owner:iterate_belt(count_item, owner)
		owner:iterate_inventory(count_item, owner)
	end)

	return count
end

local function ztc_faction_force_shield_strip_artifact(obj)
	if not obj then
		return
	end

	local function strip(_, item)
		if ztc_faction_force_shield_is_artifact(item) then
			ztc_faction_force_shield_release_item(item, true)
		end
	end

	pcall(function()
		obj:iterate_belt(strip, obj)
	end)
	pcall(function()
		obj:iterate_inventory(strip, obj)
	end)
end

local function ztc_faction_force_shield_reset_actor_state()
	actor_shield_granted = false
	actor_shield_charge = 0.0
	actor_shield_broken = false
	grant_create_pending = false
	grant_deadline_ts = 0
	grant_next_try_ts = 0
	last_ui_charge_pct = -1
	last_info_tip_pct = -1
	last_info_tip_id = nil
end

local function ztc_faction_force_shield_strip_actor()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		ztc_faction_force_shield_reset_actor_state()
		return
	end

	ztc_faction_force_shield_strip_artifact(db.actor)
	ztc_faction_force_shield_reset_actor_state()
	ztc_faction_force_shield_debug_log("stripped actor Cicatrix")
end

local function ztc_faction_force_shield_try_move_to_belt(owner)
	if not owner then
		return false
	end

	local moved = false
	pcall(function()
		owner:iterate_inventory(function(obj, item)
			if moved or not ztc_faction_force_shield_is_artifact(item) then
				return
			end
			if obj:move_to_belt(item) then
				moved = true
				ztc_faction_force_shield_lock_item(item)
			end
		end, owner)
	end)
	return moved
end

local function ztc_faction_force_shield_equip_owner(owner, reason)
	if not owner or not ztc_faction_force_shield_obj_is_alive(owner) then
		return
	end
	if not ztc_faction_utils or not ztc_faction_utils.obj_is_sin(owner) then
		return
	end

	ztc_faction_force_shield_prune_owner_duplicate_artifacts(owner, 1)

	if ztc_faction_force_shield_obj_has_artifact(owner) then
		if not ztc_faction_force_shield_obj_has_on_belt(owner) then
			ztc_faction_force_shield_try_move_to_belt(owner)
		end
		return
	end

	pcall(function()
		alife_create_item(ARTIFACT_SECTION, owner)
	end)

	ztc_faction_force_shield_prune_owner_duplicate_artifacts(owner, 1)
	if ztc_faction_force_shield_try_move_to_belt(owner) then
		ztc_faction_force_shield_debug_log("equipped on %s (%s)", owner:name(), reason or "?")
	end
end

local function ztc_faction_force_shield_schedule_equip(owner, reason)
	if not ztc_faction_force_shield_obj_is_alive(owner) then
		return
	end

	local id = owner:id()
	if not id then
		return
	end
	if npc_equip_pending[id] then
		return
	end
	npc_equip_pending[id] = true

	local event_name = "ztc_faction_fs_equip_" .. tostring(id)
	CreateTimeEvent(event_name, "go", EQUIP_DELAY_SEC, function()
		npc_equip_pending[id] = nil
		local npc = level and level.object_by_id(id)
		if not ztc_faction_force_shield_obj_is_alive(npc) then
			return true
		end
		ztc_faction_force_shield_equip_owner(npc, reason)
		return true
	end)
end

ztc_faction_force_shield_try_grant_actor = function()
	if actor_shield_granted and ztc_faction_force_shield_actor_has_artifact() then
		ztc_faction_force_shield_prune_duplicate_artifacts()
		ztc_faction_force_shield_lock_actor_artifacts()
		return true
	end

	if grant_create_pending then
		return false
	end

	if ztc_faction_force_shield_artifact_transition_active() then
		return actor_shield_granted
	end

	if not ztc_faction_force_shield_actor_enabled() then
		return false
	end
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_sin or not ztc_faction_utils.actor_is_sin() then
		return false
	end

	if ztc_faction_force_shield_inventory_ui_open() then
		return actor_shield_granted or ztc_faction_force_shield_actor_has_artifact()
	end

	if ztc_faction_force_shield_prune_duplicate_artifacts() or ztc_faction_force_shield_actor_has_artifact() then
		actor_shield_granted = true
		grant_create_pending = false
		ztc_faction_force_shield_lock_actor_artifacts()
		ztc_faction_force_shield_debug_log("found existing Cicatrix on Sin actor")
		return true
	end

	grant_create_pending = true
	actor_shield_granted = true

	local created = false
	pcall(function()
		local se_item = alife_create_item(ARTIFACT_SECTION, db.actor)
		created = se_item ~= nil
	end)

	grant_create_pending = false

	if not created and not ztc_faction_force_shield_actor_has_artifact() then
		actor_shield_granted = false
		ztc_faction_force_shield_debug_log("grant failed, will retry")
		return false
	end

	ztc_faction_force_shield_prune_duplicate_artifacts()
	ztc_faction_force_shield_lock_actor_artifacts()
	last_charge_update_ts = 0
	ztc_faction_force_shield_sync_actor_items()
	ztc_faction_force_shield_debug_log("granted Cicatrix to Sin actor (one-time)")
	return true
end

local function ztc_faction_force_shield_enforce_actor_artifact()
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end

	if ztc_faction_force_shield_inventory_ui_open() then
		return
	end

	ztc_faction_force_shield_sync_cicatrix_items(true)

	if ztc_faction_force_shield_actor_has_on_belt() then
		return
	end

	if ztc_faction_force_shield_actor_has_in_inventory() then
		-- Broken / empty charge: keep in inventory while recharging; do not fight manual belt moves.
		if not ztc_faction_force_shield_is_broken() and actor_shield_charge > 0 then
			ztc_faction_force_shield_try_move_to_belt(db.actor)
		end
		return
	end

	if ztc_faction_force_shield_artifact_transition_active() then
		return
	end

	ztc_faction_force_shield_debug_log("Cicatrix missing — re-granting")
	actor_shield_granted = false
	ztc_faction_force_shield_try_grant_actor()
	if not ztc_faction_force_shield_is_broken() and actor_shield_charge > 0 then
		ztc_faction_force_shield_try_move_to_belt(db.actor)
	end
end

ztc_faction_force_shield_preserve_cicatrix_items = function()
	ztc_faction_force_shield_sync_cicatrix_items(true)

	if ztc_faction_force_shield_actor_has_artifact_safe() then
		return true
	end

	if ztc_faction_force_shield_actor_enabled()
		and ztc_faction_utils
		and ztc_faction_utils.actor_is_sin
		and ztc_faction_utils.actor_is_sin() then
		ztc_faction_force_shield_enforce_actor_artifact()
	end

	return ztc_faction_force_shield_actor_has_artifact()
end

ztc_faction_force_shield_schedule_hit_recovery = function(force)
	if hit_recover_pending then
		return
	end
	if not force and ztc_faction_force_shield_sim_skip_heavy() then
		return
	end

	hit_recover_pending = true
	CreateTimeEvent("ztc_faction_fs_hit_recover", "go", HIT_RECOVER_DELAY_SEC, function()
		hit_recover_pending = false
		ztc_faction_force_shield_preserve_cicatrix_items()
		return true
	end)
end

local function ztc_faction_force_shield_schedule_grant_retries()
	if grant_deadline_ts > 0 then
		return
	end
	if actor_shield_granted and ztc_faction_force_shield_actor_has_artifact() then
		return
	end

	grant_deadline_ts = time_global() + 60000
	grant_next_try_ts = 0
end

local function ztc_faction_force_shield_sync_actor_toggle()
	if not ztc_faction_force_shield_actor_enabled() then
		if actor_shield_granted or ztc_faction_force_shield_actor_has_artifact() then
			ztc_faction_force_shield_strip_actor()
		end
		ztc_faction_force_shield_release_actor_hooks()
		return
	end

	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end
	if not ztc_faction_utils.actor_is_sin() then
		ztc_faction_force_shield_release_actor_hooks()
		return
	end

	local inventory_open = ztc_faction_force_shield_inventory_ui_open()

	if not ztc_faction_force_shield_actor_has_artifact() then
		ztc_faction_force_shield_schedule_grant_retries()
		if not inventory_open then
			ztc_faction_force_shield_try_grant_actor()
		end
	end

	if inventory_open then
		ztc_faction_force_shield_schedule_post_inventory_work()
		return
	end

	ztc_faction_force_shield_try_install_actor_hooks()
end

local function ztc_faction_force_shield_is_actor_slot(slot)
	if not slot or not EDDListType then
		return false
	end
	return slot == EDDListType.iActorBag
		or slot == EDDListType.iActorBelt
		or slot == EDDListType.iActorSlot
		or slot == EDDListType.iQuickSlot
end

function ztc_faction_force_shield_actor_on_before_hit(shit, bone_id, flags)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end
	if not ztc_faction_utils.actor_is_sin() then
		return
	end
	if not ztc_faction_force_shield_actor_has_on_belt() then
		return
	end
	if actor_shield_broken then
		return
	end
	if actor_shield_charge <= 0 then
		return
	end

	local charge_before = ztc_faction_force_shield_get_charge_percent()
	ztc_faction_force_shield_handle_bullet_hit(db.actor, shit, bone_id, ztc_faction_force_shield_player_damage_mult(), true)
	ztc_faction_force_shield_preserve_cicatrix_items()

	if ztc_faction_force_shield_get_charge_percent() ~= charge_before then
		ztc_faction_force_shield_refresh_inventory_on_charge_change()
	end

	if actor_shield_broken then
		ztc_faction_force_shield_schedule_hit_recovery(true)
	elseif not ztc_faction_force_shield_sim_skip_heavy() then
		ztc_faction_force_shield_sync_actor_items()
		ztc_faction_force_shield_schedule_hit_recovery()
	end
end

function ztc_faction_force_shield_npc_on_before_hit(npc, shit, bone_id, flags)
	if not ztc_faction_force_shield_npc_enabled() then
		return
	end
	if not ztc_faction_force_shield_obj_is_alive(npc) then
		return
	end
	if not ztc_faction_utils or not ztc_faction_utils.obj_is_sin(npc) then
		return
	end

	if ztc_faction_force_shield_count_owner_artifacts(npc) > 1 then
		ztc_faction_force_shield_prune_owner_duplicate_artifacts(npc, 1)
	end

	ztc_faction_force_shield_handle_bullet_hit(npc, shit, bone_id, ztc_faction_force_shield_npc_damage_mult())
end

function ztc_faction_force_shield_on_server_entity_unregister(se_obj, typ)
	if not se_obj or not se_obj.id then
		return
	end
	local id = se_obj.id
	npc_equip_pending[id] = nil
	last_hit_vfx_ts[id] = nil
end

function ztc_faction_force_shield_npc_on_net_spawn(npc, se_obj)
	if not ztc_faction_force_shield_npc_enabled() or not npc then
		return
	end
	if ztc_faction_utils and ztc_faction_utils.sim_skip_net_spawn_hooks and ztc_faction_utils.sim_skip_net_spawn_hooks() then
		return
	end
	if not ztc_faction_utils or not ztc_faction_utils.obj_is_sin(npc) then
		return
	end

	ztc_faction_force_shield_schedule_equip(npc, "spawn")
end

function ztc_faction_force_shield_npc_on_death_callback(npc, who)
	if not npc then
		return
	end
	if ztc_faction_utils and ztc_faction_utils.obj_is_sin(npc) then
		ztc_faction_force_shield_prune_owner_duplicate_artifacts(npc, 1)
	end
	last_hit_vfx_ts[npc:id()] = nil
	npc_equip_pending[npc:id()] = nil
end

function ztc_faction_force_shield_actor_item_to_belt(obj)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if ztc_faction_force_shield_is_artifact(obj) then
		ztc_faction_force_shield_mark_artifact_transition()
		ztc_faction_force_shield_lock_item(obj)
		ztc_faction_force_shield_sync_item_condition(obj)
		last_ui_charge_pct = -1
		CreateTimeEvent("ztc_faction_fs_belt_verify", "go", 0.15, function()
			ztc_faction_force_shield_preserve_cicatrix_items()
			return true
		end)
	end
end

function ztc_faction_force_shield_actor_item_to_ruck(obj)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if ztc_faction_force_shield_is_artifact(obj) then
		ztc_faction_force_shield_mark_artifact_transition()
		ztc_faction_force_shield_sync_item_condition(obj)
		last_ui_charge_pct = -1
	end
end

function ztc_faction_force_shield_actor_on_item_take(obj)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if ztc_faction_force_shield_is_artifact(obj) and ztc_faction_utils and ztc_faction_utils.actor_is_valid and ztc_faction_utils.actor_is_valid() then
		ztc_faction_force_shield_lock_item(obj)
	end
end

function ztc_faction_force_shield_actor_on_item_drop(obj)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if not ztc_faction_force_shield_is_artifact(obj) then
		return
	end
	if not ztc_faction_utils or not ztc_faction_utils.actor_is_valid or not ztc_faction_utils.actor_is_valid() then
		return
	end

	ztc_faction_force_shield_schedule_return_to_actor(obj, "ztc_faction_fs_return_drop")
end

function ztc_faction_force_shield_actor_menu_before_move(flags, npc_id, obj, mode, bag_id)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if not ztc_faction_force_shield_is_artifact(obj) then
		return
	end

	if mode == "loot" or mode == "trade" then
		flags.ret_value = false
	end
end

function ztc_faction_force_shield_actor_menu_drag_drop(obj_from, obj_to, slot_from, slot_to)
	if not ztc_faction_force_shield_actor_enabled() then
		return
	end
	if not ztc_faction_force_shield_is_artifact(obj_from) then
		return
	end

	if not ztc_faction_force_shield_is_actor_slot(slot_to) then
		if db.actor and obj_from then
			ztc_faction_force_shield_schedule_return_to_actor(obj_from, "ztc_faction_fs_return_drag")
		end
	end
end

function ztc_faction_force_shield_actor_on_first_update()
	ztc_faction_force_shield_sync_actor_toggle()
	if ztc_faction_force_shield_actor_enabled() then
		ztc_faction_force_shield_prune_duplicate_artifacts()
	end
end

function ztc_faction_force_shield_actor_on_update()
	if not ztc_faction_force_shield_actor_enabled() then
		ztc_faction_force_shield_sync_actor_toggle()
		return
	end

	if ztc_faction_force_shield_sim_skip_heavy() then
		return
	end

	local now = time_global()
	local grant_retry_ms = ztc_faction_force_shield_sim_interval_ms(500)
	local sync_interval_ms = ztc_faction_force_shield_sim_interval_ms(CONDITION_SYNC_MS)

	if grant_deadline_ts > 0 then
		if now <= grant_deadline_ts and now >= grant_next_try_ts then
			grant_next_try_ts = now + grant_retry_ms
			if actor_shield_granted and ztc_faction_force_shield_actor_has_artifact() then
				grant_deadline_ts = 0
			elseif not ztc_faction_force_shield_inventory_ui_open() then
				ztc_faction_force_shield_try_grant_actor()
			end
		elseif now > grant_deadline_ts then
			grant_deadline_ts = 0
			if actor_shield_granted and not ztc_faction_force_shield_actor_has_artifact() then
				actor_shield_granted = false
				ztc_faction_force_shield_debug_log("grant flag cleared after retries — item still missing")
			end
		end
	end

	if last_charge_update_ts == 0 then
		last_charge_update_ts = now
	end

	local delta_sec = (now - last_charge_update_ts) / 1000.0
	last_charge_update_ts = now
	if delta_sec > MAX_CHARGE_UPDATE_DELTA_SEC then
		delta_sec = MAX_CHARGE_UPDATE_DELTA_SEC
	end
	ztc_faction_force_shield_update_charge(delta_sec)

	if now >= condition_sync_next_ts then
		condition_sync_next_ts = now + sync_interval_ms
		if not ztc_faction_force_shield_inventory_ui_open() then
			ztc_faction_force_shield_sync_actor_items()
		end
	end
end

function ztc_faction_force_shield_finish_game_load()
	if not ztc_faction_force_shield_actor_enabled() then
		if actor_shield_granted or ztc_faction_force_shield_actor_has_artifact() then
			ztc_faction_force_shield_strip_actor()
		end
		ztc_faction_force_shield_release_actor_hooks()
		return
	end

	if actor_shield_granted then
		if ztc_faction_utils and ztc_faction_utils.actor_is_valid and ztc_faction_utils.actor_is_valid() then
			ztc_faction_force_shield_prune_duplicate_artifacts()
			if ztc_faction_force_shield_actor_has_artifact() then
				ztc_faction_force_shield_lock_actor_artifacts()
				ztc_faction_force_shield_try_install_actor_hooks()
				return
			end
			ztc_faction_force_shield_debug_log("grant flag set but item missing after load — re-granting")
		else
			ztc_faction_force_shield_debug_log("grant flag set but item not spawned yet — waiting")
		end
		ztc_faction_force_shield_schedule_grant_retries()
		ztc_faction_force_shield_try_grant_actor()
		ztc_faction_force_shield_try_install_actor_hooks()
		return
	end

	ztc_faction_force_shield_schedule_grant_retries()
	ztc_faction_force_shield_try_grant_actor()
	ztc_faction_force_shield_try_install_actor_hooks()
end

function ztc_faction_force_shield_on_game_load()
	CreateTimeEvent("ztc_faction_fs_load", "verify", 0.15, function()
		ztc_faction_force_shield_finish_game_load()
		return true
	end)
end

function ztc_faction_force_shield_save_state(mdata)
	if not mdata then
		return
	end
	mdata[SAVE_KEY_GRANTED] = actor_shield_granted
	mdata[SAVE_KEY_CHARGE] = actor_shield_charge
	mdata[SAVE_KEY_BROKEN] = actor_shield_broken
end

function ztc_faction_force_shield_load_state(mdata)
	actor_shield_granted = mdata and mdata[SAVE_KEY_GRANTED] == true
	actor_shield_charge = ztc_faction_force_shield_clamp_charge(mdata and mdata[SAVE_KEY_CHARGE])
	actor_shield_broken = mdata and mdata[SAVE_KEY_BROKEN] == true
	grant_create_pending = false
	if actor_shield_broken and actor_shield_charge >= 1.0 then
		actor_shield_broken = false
	end
	last_charge_update_ts = 0
	last_ui_charge_pct = -1
	last_info_tip_pct = -1
	last_info_tip_id = nil
	grant_deadline_ts = 0
end

function ztc_faction_force_shield_on_option_change(mcm)
	CreateTimeEvent("ztc_faction_fs_mcm_toggle", "go", 0.25, function()
		ztc_faction_force_shield_sync_actor_toggle()
		return true
	end)
end

function on_game_start()
	RegisterScriptCallback("actor_on_before_hit", ztc_faction_force_shield_actor_on_before_hit)
	RegisterScriptCallback("npc_on_before_hit", ztc_faction_force_shield_npc_on_before_hit)
	RegisterScriptCallback("npc_on_net_spawn", ztc_faction_force_shield_npc_on_net_spawn)
	RegisterScriptCallback("server_entity_on_unregister", ztc_faction_force_shield_on_server_entity_unregister)
	RegisterScriptCallback("npc_on_death_callback", ztc_faction_force_shield_npc_on_death_callback)
	RegisterScriptCallback("actor_item_to_belt", ztc_faction_force_shield_actor_item_to_belt)
	RegisterScriptCallback("actor_item_to_ruck", ztc_faction_force_shield_actor_item_to_ruck)
	RegisterScriptCallback("actor_on_item_take", ztc_faction_force_shield_actor_on_item_take)
	RegisterScriptCallback("actor_on_item_drop", ztc_faction_force_shield_actor_on_item_drop)
	RegisterScriptCallback("ActorMenu_on_item_before_move", ztc_faction_force_shield_actor_menu_before_move)
	RegisterScriptCallback("ActorMenu_on_item_drag_drop", ztc_faction_force_shield_actor_menu_drag_drop)
	RegisterScriptCallback("actor_on_first_update", ztc_faction_force_shield_actor_on_first_update)
	RegisterScriptCallback("actor_on_update", ztc_faction_force_shield_actor_on_update)
	RegisterScriptCallback("on_game_load", ztc_faction_force_shield_on_game_load)
	RegisterScriptCallback("save_state", ztc_faction_force_shield_save_state)
	RegisterScriptCallback("load_state", ztc_faction_force_shield_load_state)
	RegisterScriptCallback("on_option_change", ztc_faction_force_shield_on_option_change)
	RegisterScriptCallback("ActorMenu_on_mode_changed", ztc_faction_force_shield_on_actor_menu_mode)
	RegisterScriptCallback("GUI_on_show", function(name)
		if name == "Inventory" or name == "InventoryTrade" then
			last_ui_charge_pct = -1
		end
	end)

	CreateTimeEvent("ztc_faction_fs_boot_grant", "go", 3.0, function()
		if not ztc_faction_force_shield_actor_enabled() then
			ztc_faction_force_shield_strip_actor()
			ztc_faction_force_shield_release_actor_hooks()
			return true
		end
		if not actor_shield_granted then
			ztc_faction_force_shield_schedule_grant_retries()
			ztc_faction_force_shield_try_grant_actor()
		end
		return true
	end)
end
