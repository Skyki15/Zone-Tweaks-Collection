local function ztc_faction_is_psy_anomaly(anomaly)
	if not anomaly or not anomaly.section then
		return false
	end

	local section = anomaly:section()
	if not section then
		return false
	end

	return string.find(section, "psy", 1, true) ~= nil
end

function ztc_faction_psy_on_before_activate(anomaly, obj, flags)
	if not flags then
		return
	end

	if not ztc_faction_utils.is_mod_enabled() then
		return
	end

	if not ztc_faction_utils.actor_is_valid() or not obj or obj:id() ~= db.actor:id() then
		return
	end

	if not ztc_faction_utils.actor_is_psy_immune() then
		return
	end

	if not ztc_faction_is_psy_anomaly(anomaly) then
		return
	end

	flags.ret_value = false
end

function on_game_start()
	RegisterScriptCallback("anomaly_on_before_activate", ztc_faction_psy_on_before_activate)
end
