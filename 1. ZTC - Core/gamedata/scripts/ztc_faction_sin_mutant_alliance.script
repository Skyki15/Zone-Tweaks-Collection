local HOSTILITY_MEMORY_CAP = 50
local HOSTILITY_TTL_MS = 21600000
local HOSTILITY_PRUNE_INTERVAL_MS = 60000
local hostile_mutants = {}
local next_prune_ts = 0

local function ztc_faction_alliance_is_stalker_monster_pair(a, b)
	return IsStalker(a) and IsMonster(b)
end

local function ztc_faction_alliance_is_sin_mutant_pair(a, b)
	if not a or not b then
		return false
	end
	return (ztc_faction_alliance_is_stalker_monster_pair(a, b) and ztc_faction_utils.obj_is_sin(a))
		or (ztc_faction_alliance_is_stalker_monster_pair(b, a) and ztc_faction_utils.obj_is_sin(b))
end

local function ztc_faction_alliance_remember_hostile(monster)
	if not monster then
		return
	end

	local now = time_global()
	hostile_mutants[monster:id()] = {
		section = monster:section(),
		ts = now
	}

	local squad = get_object_squad(monster)
	if not squad then
		return
	end

	for member in squad:squad_members() do
		local lobj = level.object_by_id(member.id)
		hostile_mutants[member.id] = {
			section = lobj and lobj:section() or nil,
			ts = now
		}
	end
end

local function ztc_faction_alliance_prune_memory(now)
	for id, entry in pairs(hostile_mutants) do
		local expired = type(entry) ~= "table" or not entry.ts or (now - entry.ts) > HOSTILITY_TTL_MS
		if expired then
			hostile_mutants[id] = nil
		end
	end

	local entries = {}
	for id, entry in pairs(hostile_mutants) do
		entries[#entries + 1] = { id = id, ts = entry.ts or 0 }
	end

	if #entries <= HOSTILITY_MEMORY_CAP then
		return
	end

	table.sort(entries, function(a, b)
		return a.ts < b.ts
	end)

	local to_remove = #entries - HOSTILITY_MEMORY_CAP
	for i = 1, to_remove do
		hostile_mutants[entries[i].id] = nil
	end
end

local function ztc_faction_alliance_is_hostile(obj, now)
	if not obj then
		return false
	end

	local entry = hostile_mutants[obj:id()]
	if type(entry) ~= "table" then
		hostile_mutants[obj:id()] = nil
		return false
	end

	if entry.ts and (now - entry.ts) > HOSTILITY_TTL_MS then
		hostile_mutants[obj:id()] = nil
		return false
	end

	if entry.section and entry.section ~= obj:section() then
		hostile_mutants[obj:id()] = nil
		return false
	end

	return true
end

function ztc_faction_alliance_monster_on_before_hit(victim, hit, bone_id, flags)
	if not ztc_faction_utils.is_sin_mutant_alliance_enabled() then
		return
	end

	if not ztc_faction_utils.actor_is_valid() or not victim or not hit or not hit.draftsman then
		return
	end

	local attacker = hit.draftsman
	if attacker:id() ~= db.actor:id() then
		return
	end

	if not IsMonster(victim) then
		return
	end

	if not ztc_faction_utils.obj_is_sin(attacker) then
		return
	end

	ztc_faction_alliance_remember_hostile(victim)
end

function ztc_faction_alliance_on_enemy_eval(npc, enemy, flags)
	if not ztc_faction_utils.is_sin_mutant_alliance_enabled() then
		return
	end

	if not npc or not enemy or not flags then
		return
	end

	if ztc_faction_escorts and ztc_faction_escorts.is_sin_escort then
		if ztc_faction_escorts.is_sin_escort(npc) or ztc_faction_escorts.is_sin_escort(enemy) then
			return
		end
	end

	if not ztc_faction_alliance_is_sin_mutant_pair(npc, enemy) then
		return
	end

	local now = time_global()
	if now >= next_prune_ts then
		ztc_faction_alliance_prune_memory(now)
		next_prune_ts = now + HOSTILITY_PRUNE_INTERVAL_MS
	end

	if ztc_faction_alliance_is_hostile(npc, now) or ztc_faction_alliance_is_hostile(enemy, now) then
		flags.override = false
		return
	end

	flags.override = true
	flags.result = false
end

function ztc_faction_alliance_save_state(mdata)
	mdata.ztc_faction_sin_mutant_hostility = hostile_mutants
end

function ztc_faction_alliance_load_state(mdata)
	if mdata and mdata.ztc_faction_sin_mutant_hostility then
		hostile_mutants = mdata.ztc_faction_sin_mutant_hostility
	else
		hostile_mutants = {}
	end

	ztc_faction_alliance_prune_memory(time_global())
	next_prune_ts = time_global() + HOSTILITY_PRUNE_INTERVAL_MS
end

function ztc_faction_sin_alliance_is_hostile_mutant(obj, now)
	if not ztc_faction_utils.is_sin_mutant_alliance_enabled() then
		return false
	end

	return ztc_faction_alliance_is_hostile(obj, now or time_global())
end

function on_game_start()
	_G.ztc_faction_sin_alliance = _G.ztc_faction_sin_alliance or {}
	_G.ztc_faction_sin_alliance.is_hostile_mutant = ztc_faction_sin_alliance_is_hostile_mutant

	RegisterScriptCallback("on_enemy_eval", ztc_faction_alliance_on_enemy_eval)
	RegisterScriptCallback("monster_on_before_hit", ztc_faction_alliance_monster_on_before_hit)
	RegisterScriptCallback("save_state", ztc_faction_alliance_save_state)
	RegisterScriptCallback("load_state", ztc_faction_alliance_load_state)
end
