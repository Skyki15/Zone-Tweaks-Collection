-- Zone Tweaks Collection — rank / species tables and resolution helpers

_G.ztc_health_data = _G.ztc_health_data or {}
local data = _G.ztc_health_data

data.MIN_MULT = 0.25
data.MAX_MULT = 3.0
data.DEFAULT_MULT = 1.0

-- Personal reset baselines for MCM sliders (omit entries to fall back to DEFAULT_MULT).
data.RANK_DEFAULTS = {}

data.FACTION_DEFAULTS = {}

data.SPECIES_DEFAULTS = {}

data.STALKER_RANKS = {
	"novice",
	"trainee",
	"experienced",
	"professional",
	"veteran",
	"expert",
	"master",
	"legend",
}

data.STALKER_FACTIONS = {
	"stalker",
	"bandit",
	"csky",
	"dolg",
	"freedom",
	"killer",
	"army",
	"ecolog",
	"monolith",
	"renegade",
	"greh",
	"isg",
	"zombied",
}

data.MUTANT_SPECIES = {
	"dog",
	"flesh",
	"bloodsucker",
	"boar",
	"burer",
	"cat",
	"controller",
	"fracture",
	"karlik",
	"pseudodog",
	"pseudo_gigant",
	"snork",
	"tushkano",
	"zombie",
	"lurker",
	"psysucker",
	"chimera",
	"poltergeist",
	"rat",
}

data.SECTION_SPECIES = {
	m_chimera_e = "chimera",
	chimera_weak = "chimera",
	chimera_normal = "chimera",
	chimera_normal2 = "chimera",
	chimera_normal3 = "chimera",
	chimera_strong = "chimera",
	chimera_strong2 = "chimera",
	chimera_strong3 = "chimera",
	chimera_strong4 = "chimera",
	m_poltergeist_e = "poltergeist",
	m_poltergeist_normal_tele = "poltergeist",
	m_poltergeist_normal_flame = "poltergeist",
	m_poltergeist_normal_black = "poltergeist",
	poltergeist_build = "poltergeist",
	poltergeist_fake = "poltergeist",
	psy_dog = "pseudodog",
	psy_dog_normal = "pseudodog",
	psy_dog_phantom = "pseudodog",
}

local INVALID_COMMUNITIES = {
	monster = true,
	actor = true,
	trader = true,
}

function data.clamp_multiplier(value)
	if not value then
		return data.DEFAULT_MULT
	end
	if value < data.MIN_MULT then
		return data.MIN_MULT
	end
	if value > data.MAX_MULT then
		return data.MAX_MULT
	end
	return value
end

function data.get_rank_default(rank)
	if rank and data.RANK_DEFAULTS[rank] ~= nil then
		return data.clamp_multiplier(data.RANK_DEFAULTS[rank])
	end
	return data.DEFAULT_MULT
end

function data.get_faction_default(faction)
	if faction and data.FACTION_DEFAULTS[faction] ~= nil then
		return data.clamp_multiplier(data.FACTION_DEFAULTS[faction])
	end
	return data.DEFAULT_MULT
end

function data.combine_multipliers(...)
	local combined = data.DEFAULT_MULT
	for i = 1, select("#", ...) do
		local mult = select(i, ...)
		if mult then
			combined = combined * mult
		end
	end
	return data.clamp_multiplier(combined)
end

function data.get_species_default(species)
	if species and data.SPECIES_DEFAULTS[species] ~= nil then
		return data.clamp_multiplier(data.SPECIES_DEFAULTS[species])
	end
	return data.DEFAULT_MULT
end

function data.get_stalker_rank(obj)
	if not obj or not ranks or not ranks.get_obj_rank_name then
		return nil
	end
	return ranks.get_obj_rank_name(obj)
end

function data.normalize_stalker_faction(comm)
	if not comm or comm == "" then
		return nil
	end

	if comm:match("^actor_") then
		comm = comm:sub(7)
	end

	for i = 1, #data.STALKER_FACTIONS do
		if data.STALKER_FACTIONS[i] == comm then
			return comm
		end
	end

	return nil
end

function data.get_stalker_faction(obj)
	if not obj then
		return nil
	end

	if character_community then
		return data.normalize_stalker_faction(character_community(obj))
	end

	if obj.character_community then
		return data.normalize_stalker_faction(obj:character_community())
	end

	return nil
end

local function valid_community(comm)
	return comm and comm ~= "" and not INVALID_COMMUNITIES[comm]
end

function data.get_mutant_species(obj, se_obj)
	if not obj then
		return nil
	end

	if se_obj and se_obj.community then
		local comm = se_obj:community()
		if valid_community(comm) then
			return comm
		end
	end

	if obj.community then
		local ok, comm = pcall(function()
			return obj:community()
		end)
		if ok and valid_community(comm) then
			return comm
		end
	end

	local sec = obj:section()
	if not sec then
		return nil
	end

	if data.SECTION_SPECIES[sec] then
		return data.SECTION_SPECIES[sec]
	end

	local comm = ini_sys:r_string_ex(sec, "community")
	if valid_community(comm) then
		return comm
	end

	local species = ini_sys:r_string_ex(sec, "species")
	if species and species ~= "" and species ~= "actor" and species ~= "human" then
		return species
	end

	return nil
end
