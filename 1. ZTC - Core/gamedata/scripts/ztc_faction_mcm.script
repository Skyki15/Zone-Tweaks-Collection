local MCM_SETTINGS = MCM_ROOT .. "settings/"

-- Read axr_options / MCM slider values without requiring Faction Tweaks master ON.
function mcm.get_raw_mcm_value(key)
	if not ui_mcm then
		return nil
	end

	local section = def_map[key]
	if section then
		local val = ui_mcm.get(MCM_ROOT .. section .. "/" .. key)
		if val ~= nil then
			return val
		end
	end

	return ui_mcm.get(MCM_ROOT .. key)
end

function mcm.is_enabled()
	if ui_mcm then
		local val = ui_mcm.get(MCM_SETTINGS .. "enabled")
		if val ~= nil then
			return val == true
		end
	end
	return defaults.enabled == true
end

function mcm.get_config(key)
	if key == "enabled" then
		return mcm.is_enabled()
	end

	if not mcm.is_enabled() then
		if key == "monolith_rupture_resistance_actor" or key == "monolith_rupture_resistance_npc" then
			return 0
		end
		if defaults[key] ~= nil and type(defaults[key]) == "boolean" then
			return false
		end
		return nil
	end

	if ui_mcm then
		local section = def_map[key]
		if section then
			local val = ui_mcm.get(MCM_ROOT .. section .. "/" .. key)
			if val ~= nil then
				return val
			end
		end

		local val = ui_mcm.get(MCM_ROOT .. key)
		if val ~= nil then
			return val
		end
	end

	if defaults[key] ~= nil then
		return defaults[key]
	end

	return nil
end

function mcm.is_vanilla_payment_recruitment_disabled(key)
	local config_key = key .. "_disable_vanilla_payment_recruitment"
	if defaults[config_key] == nil then
		return false
	end

	if mcm.is_enabled() and ui_mcm then
		local section = def_map[config_key]
		if section then
			local val = ui_mcm.get(MCM_ROOT .. section .. "/" .. config_key)
			if val ~= nil then
				return val == true
			end
		end
	end

	return defaults[config_key] == true
end

local function build_faction_placeholder_menu(section_id, title_id)
	return {
		id = section_id,
		sh = true,
		gr = {
			{
				id = "title",
				type = "slide",
				link = "ui_options_slider_disguise",
				text = title_id,
				size = {512, 50},
				spacing = 20,
			},
			{
				id = "placeholder_desc",
				type = "desc",
				text = "ui_mcm_ztc_faction_placeholder_desc",
				clr = {255, 200, 200, 200},
			},
		},
	}
end

local function build_start_companions_menu_items(faction_key, max_count)
	max_count = max_count or 3
	return {
		{
			id = faction_key .. "_start_with_companions",
			type = "check",
			val = 1,
			def = defaults[faction_key .. "_start_with_companions"],
			hint = "ztc_faction_" .. faction_key .. "_start_with_companions",
		},
		{
			id = faction_key .. "_start_with_companions_desc",
			type = "desc",
			text = "ui_mcm_ztc_faction_" .. faction_key .. "_start_with_companions_desc",
			clr = {255, 200, 200, 200},
		},
		{
			id = faction_key .. "_start_with_companions_count",
			type = "track",
			val = 2,
			min = 1,
			max = max_count,
			step = 1,
			def = defaults[faction_key .. "_start_with_companions_count"],
			hint = "ztc_faction_" .. faction_key .. "_start_with_companions_count",
		},
		{ id = "divider_" .. faction_key .. "_start_companions", type = "line" },
	}
end

local function append_menu_items(gr, items)
	for i = 1, #items do
		gr[#gr + 1] = items[i]
	end
end

local function build_high_rank_flee_menu_items(key_prefix, with_divider)
	local config_key = key_prefix .. "_disable_high_rank_fleeing"
	local items = {}

	if with_divider then
		items[#items + 1] = { id = "divider_" .. key_prefix .. "_high_rank_flee", type = "line" }
	end

	items[#items + 1] = {
		id = config_key,
		type = "check",
		val = 1,
		def = defaults[config_key],
		hint = "ztc_faction_" .. config_key,
	}
	items[#items + 1] = {
		id = config_key .. "_desc",
		type = "desc",
		text = "ui_mcm_ztc_faction_disable_high_rank_fleeing_desc",
		clr = {255, 200, 200, 200},
	}

	return items
end

local function build_high_rank_flee_only_menu(section_id, title_id, key_prefix)
	local gr = {
		{
			id = "title",
			type = "slide",
			link = "ui_options_slider_disguise",
			text = title_id,
			size = {512, 50},
			spacing = 20,
		},
	}

	local flee_items = build_high_rank_flee_menu_items(key_prefix, false)
	for i = 1, #flee_items do
		gr[#gr + 1] = flee_items[i]
	end

	return {
		id = section_id,
		sh = true,
		gr = gr,
	}
end

