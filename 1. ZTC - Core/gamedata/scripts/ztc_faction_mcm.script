			link = "ui_options_slider_disguise",
			text = "ui_mcm_ztc_faction_isg_title",
			size = {512, 50},
			spacing = 20,
		},
	}
	append_menu_items(gr, build_start_companions_menu_items("isg", 2))
	gr[#gr + 1] = {
		id = "isg_disable_fleeing",
		type = "check",
		val = 1,
		def = defaults.isg_disable_fleeing,
		hint = "ztc_faction_isg_disable_fleeing",
	}
	gr[#gr + 1] = {
		id = "isg_disable_fleeing_desc",
		type = "desc",
		text = "ui_mcm_ztc_faction_disable_fleeing_desc",
		clr = {255, 200, 200, 200},
	}
	return {
		id = SUB_ISG,
		sh = true,
		gr = gr,
	}
end

