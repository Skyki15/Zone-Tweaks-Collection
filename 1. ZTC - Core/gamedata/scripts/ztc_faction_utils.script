-- Shared faction/community helpers for ZTC Faction Tweaks.

_G.ztc_faction_utils = _G.ztc_faction_utils or {}
local utils = _G.ztc_faction_utils

utils.SIN_COMMUNITIES = {
	greh = true,
	actor_greh = true
}

utils.MONOLITH_COMMUNITIES = {
	monolith = true,
	actor_monolith = true
}

-- Scale Sin sim hooks when time_factor is boosted (debug fast-forward, etc.).
local SIM_INTERVAL_SCALE_START = 2.0
local SIM_INTERVAL_SCALE_CAP = 80.0
local SIM_SKIP_NET_SPAWN_FACTOR = 40.0
local SIM_SKIP_HEAVY_FACTOR = 100.0

function utils.get_sim_time_factor()
	if level and level.get_time_factor then
		local ok, tf = pcall(level.get_time_factor)
		if ok and type(tf) == "number" and tf > 0 then
			return tf
		end
	end
	return 1.0
end

function utils.sim_interval_ms(base_ms)
	local tf = utils.get_sim_time_factor()
	if tf <= SIM_INTERVAL_SCALE_START then
		return base_ms
	end
	local scale = math.min(tf, SIM_INTERVAL_SCALE_CAP)
	return math.floor(base_ms * scale)
end

function utils.sim_skip_net_spawn_hooks()
	return utils.get_sim_time_factor() >= SIM_SKIP_NET_SPAWN_FACTOR
end

function utils.sim_skip_heavy_work()
	return utils.get_sim_time_factor() >= SIM_SKIP_HEAVY_FACTOR
end

function utils.obj_is_alive(obj)
	if not obj then
		return false
	end
	local ok, alive = pcall(function()
		return obj.alive and obj:alive()
	end)
	return ok and alive == true
end

function utils.actor_is_valid()
	return utils.obj_is_alive(db and db.actor)
end

function utils.get_actor_community(obj)
	if not obj then
		return nil
	end

	if utils.actor_is_valid() and obj:id() == db.actor:id() and get_actor_true_community then
		local true_com = get_actor_true_community()
		if true_com and true_com ~= "" then
			return true_com
		end
	end

	if character_community then
		return character_community(obj)
	end

	return nil
end

function utils.community_is_sin(com)
	return com and utils.SIN_COMMUNITIES[com] == true
end

function utils.actor_is_sin()
	if not utils.actor_is_valid() then
		return false
	end

	if character_community then
		local char_com = character_community(db.actor)
		if utils.community_is_sin(char_com) then
			return true
		end
	end

	return utils.community_is_sin(utils.get_actor_community(db.actor))
end

function utils.community_is_monolith(com)
	return com and utils.MONOLITH_COMMUNITIES[com] == true
end

function utils.actor_is_monolith()
	if not utils.actor_is_valid() then
		return false
	end
	return utils.community_is_monolith(utils.get_actor_community(db.actor))
end

function utils.obj_is_monolith(obj)
	if not obj or IsMonster(obj) then
		return false
	end
	return utils.community_is_monolith(utils.get_actor_community(obj))
end

function utils.is_mod_enabled()
	if ztc_faction_mcm and ztc_faction_mcm.is_enabled then
		return ztc_faction_mcm.is_enabled()
	end
	return true
end

function utils.is_sin_mutant_alliance_enabled()
	if not utils.is_mod_enabled() then
		return false
	end

	if ztc_faction_mcm and ztc_faction_mcm.get_config then
		return ztc_faction_mcm.get_config("sin_mutant_alliance_enabled") == true
	end

	return false
end

function utils.actor_is_psy_immune()
	if not utils.is_mod_enabled() then
		return false
	end

	if not utils.actor_is_valid() then
		return false
	end

	local monolith_immunity = false
	if ztc_faction_mcm and ztc_faction_mcm.get_config then
		monolith_immunity = ztc_faction_mcm.get_config("monolith_psy_immunity")
	end

	if utils.actor_is_monolith() then
		return monolith_immunity == true
	end

	return false
end

function utils.obj_is_sin(obj)
	return utils.community_is_sin(utils.get_actor_community(obj))
end

function utils.is_monolith_easier_companion_recruit_enabled(require_actor_monolith)
	if not utils.is_mod_enabled() then
		return false
	end

	if ztc_faction_mcm and ztc_faction_mcm.get_config then
		if ztc_faction_mcm.get_config("monolith_easier_companion_recruit") ~= true then
			return false
		end
	else
		return false
	end

	if require_actor_monolith and not utils.actor_is_monolith() then
		return false
	end

	return true
end
