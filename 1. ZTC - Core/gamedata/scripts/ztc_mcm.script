-- Zone Tweaks Collection — Mod Configuration Menu

_G.ztc_mcm = _G.ztc_mcm or {}
local mcm = _G.ztc_mcm

local data = ztc_health_data
local dmg_data = ztc_damage_data
local MCM_ROOT = "ztc/health_tweaks/"
local MCM_SETTINGS = MCM_ROOT .. "settings/"
local MCM_STALKER = MCM_ROOT .. "stalker/"
local MCM_MUTANTS = MCM_ROOT .. "mutants/"

local BOOL_DEFAULTS = {
	enabled            = false,
	exclude_story_npcs = false,
	exclude_companions = false,
	exclude_traders    = false,
	reapply_on_change  = false,
}

function mcm.get_config(key)
	if ui_mcm then
		local paths = {
			MCM_SETTINGS .. key,
			MCM_ROOT .. key,
			MCM_STALKER .. key,
			MCM_MUTANTS .. key,
		}
		for i = 1, #paths do
			local val = ui_mcm.get(paths[i])
			if val ~= nil then
				return val
			end
		end
	end

	if BOOL_DEFAULTS[key] ~= nil then
		return BOOL_DEFAULTS[key]
	end

	local rank = key:match("^rank_(.+)$")
	if rank then
		return data.get_rank_default(rank)
	end

	local faction = key:match("^faction_(.+)$")
	if faction then
		return data.get_faction_default(faction)
	end

	local species = key:match("^species_(.+)$")
	if species then
		return data.get_species_default(species)
	end

	return data.DEFAULT_MULT
end

local function mult_track(id, hint, def)
	return {
		id = id,
		type = "track",
		val = 2,
		min = data.MIN_MULT,
		max = data.MAX_MULT,
		step = 0.05,
		def = def or data.DEFAULT_MULT,
		hint = hint,
	}
end

local function build_stalker_menu()
	local gr = {
		{
			id = "title",
			type = "slide",
			link = "ui_options_slider_disguise",
			text = "ui_mcm_ztc_health_stalker_title",
			size = {512, 50},
			spacing = 20,
		},
		{
			id = "stalkers_desc",
			type = "desc",
			text = "ui_mcm_ztc_health_stalkers_desc",
			clr = {255, 200, 200, 200},
		},
		{ id = "divider_filters", type = "line" },
		{
			id = "exclude_story_npcs",
			type = "check",
			val = 1,
			def = BOOL_DEFAULTS.exclude_story_npcs,
			hint = "ztc_health_exclude_story_npcs",
		},
		{
			id = "exclude_companions",
			type = "check",
			val = 1,
			def = BOOL_DEFAULTS.exclude_companions,
			hint = "ztc_health_exclude_companions",
		},
		{
			id = "exclude_traders",
			type = "check",
			val = 1,
			def = BOOL_DEFAULTS.exclude_traders,
			hint = "ztc_health_exclude_traders",
		},
		{ id = "divider_ranks", type = "line" },
	}

	for i = 1, #data.STALKER_RANKS do
		local rank = data.STALKER_RANKS[i]
		gr[#gr + 1] = mult_track(
			"rank_" .. rank,
			"ztc_health_rank_" .. rank,
			data.get_rank_default(rank)
		)
	end

	gr[#gr + 1] = { id = "divider_factions", type = "line" }
	gr[#gr + 1] = {
		id = "factions_desc",
		type = "desc",
		text = "ui_mcm_ztc_health_factions_desc",
		clr = {255, 200, 200, 200},
	}

	for i = 1, #data.STALKER_FACTIONS do
		local faction = data.STALKER_FACTIONS[i]
		gr[#gr + 1] = mult_track(
			"faction_" .. faction,
			"ztc_health_faction_" .. faction,
			data.get_faction_default(faction)
		)
	end

	return {
		id = "stalker",
		sh = true,
		gr = gr,
	}
end

