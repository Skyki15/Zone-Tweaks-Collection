function on_mcm_load()
	return {
		id = "ztc",
		gr = {
			build_general_menu(),
			ztc_player_mcm.build_player_tweaks_menu(),
			build_health_tweaks_menu(),
			build_damage_tweaks_menu(),
			ztc_faction_mcm.build_faction_tweaks_menu(),
		},
	}
end
