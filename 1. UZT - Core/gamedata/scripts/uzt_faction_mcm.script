-- Ultimate Zone Tweaks — Faction Tweaks MCM

_G.uzt_faction_mcm = _G.uzt_faction_mcm or {}
local mcm = _G.uzt_faction_mcm

local MCM_ROOT = "uzt/faction_tweaks/"
local SUB_MONOLITH = "monolith"
local SUB_SIN = "sin"

local defaults = {
	enabled = false,
	monolith_psy_immunity = true,
	monolith_rupture_resistance = 25,
	sin_max_companions = 3,
	sin_companion_teleport_dist = 30,
	sin_squad_escorts_enabled = true,
	sin_squad_escort_chance = 40,
	sin_squad_escorts_max_per_squad = 1,
	sin_squad_escorts_max_active = 6,
	force_shield_enabled = true,
	force_shield_player_bullet_reduction = 40,
	force_shield_npc_bullet_reduction = 60,
	force_shield_recharge_normal_sec = 5,
	force_shield_recharge_broken_sec = 2,
	force_shield_debug_log = false,
}

local def_map = {
	monolith_psy_immunity = SUB_MONOLITH,
	monolith_rupture_resistance = SUB_MONOLITH,
	sin_max_companions = SUB_SIN,
	sin_companion_teleport_dist = SUB_SIN,
	sin_squad_escorts_enabled = SUB_SIN,
	sin_squad_escort_chance = SUB_SIN,
	sin_squad_escorts_max_per_squad = SUB_SIN,
	sin_squad_escorts_max_active = SUB_SIN,
	force_shield_enabled = SUB_SIN,
	force_shield_player_bullet_reduction = SUB_SIN,
	force_shield_npc_bullet_reduction = SUB_SIN,
	force_shield_recharge_normal_sec = SUB_SIN,
	force_shield_recharge_broken_sec = SUB_SIN,
	force_shield_debug_log = SUB_SIN,
}

local MCM_SETTINGS = MCM_ROOT .. "settings/"

function mcm.is_enabled()
	if ui_mcm then
		local val = ui_mcm.get(MCM_SETTINGS .. "enabled")
		if val ~= nil then
			return val == true
		end
	end
	return defaults.enabled == true
end

function mcm.get_config(key)
	if key == "enabled" then
		return mcm.is_enabled()
	end

	if not mcm.is_enabled() then
		if key == "monolith_rupture_resistance" then
			return 0
		end
		if defaults[key] ~= nil and type(defaults[key]) == "boolean" then
			return false
		end
		return nil
	end

	if ui_mcm then
		local section = def_map[key]
		if section then
			local val = ui_mcm.get(MCM_ROOT .. section .. "/" .. key)
			if val ~= nil then
				return val
			end
		end

		local val = ui_mcm.get(MCM_ROOT .. key)
		if val ~= nil then
			return val
		end
	end

	if defaults[key] ~= nil then
		return defaults[key]
	end

	return nil
end

local function build_faction_settings_menu()
	return {
		id = "settings",
		sh = true,
		gr = {
			{
				id = "title",
				type = "slide",
				link = "ui_options_slider_disguise",
				text = "ui_mcm_uzt_faction_general_title",
				size = {512, 50},
				spacing = 20,
			},
			{ id = "divider_main", type = "line" },
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = defaults.enabled,
				hint = "uzt_faction_enabled",
			},
			{
				id = "enabled_desc",
				type = "desc",
				text = "ui_mcm_uzt_faction_enabled_desc",
				clr = {255, 200, 200, 200},
			},
		},
	}
end

