<string_table>
	<string id="ui_mcm_menu_general">
		<text>General</text>
	</string>

	<string id="ui_mcm_uzt_general_title">
		<text>General</text>
	</string>

	<string id="ui_mcm_uzt_general_disable_wounded_state">
		<text>Disable wounded state</text>
	</string>

	<string id="ui_mcm_uzt_general_disable_wounded_state_desc">
		<text>Stalkers stay on their feet at low health instead of lying wounded.</text>
	</string>

	<string id="ui_mcm_uzt_general_exclude_story_npcs">
		<text>Exclude story NPCs (keep wounded behavior)</text>
	</string>

	<string id="ui_mcm_uzt_general_exclude_monolith">
		<text>Exclude Monolith (keep wounded behavior)</text>
	</string>

	<string id="ui_mcm_uzt_general_wounded_compat_desc">
		<text>Unchecking story exclusion may conflict with quest scripts that rely on wounded state. Monolith exclusion preserves their wounded suicide grenade behavior.</text>
	</string>

	<string id="ui_mcm_uzt_general_disable_weapon_warnings">
		<text>Disable weapon warnings</text>
	</string>

	<string id="ui_mcm_uzt_general_disable_weapon_warnings_desc">
		<text>Stalkers treat you as unarmed for meet/warning checks while your weapon is out. Toggles off instantly via MCM.</text>
	</string>
</string_table>
